{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drenyra.dev/harness/contracts/receipts/receipt-content.schema.json",
  "title": "ReceiptContent",
  "description": "The canonical content that enters the receipt hash — mirrors the pinned drenyra-ai@0.2.0 ReceiptContent shape field-for-field. proposalVersion is a JSON integer, never a float; evidenceHash and payloadHash are lowercase hex sha-256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "missionId",
    "companyId",
    "actorId",
    "decision",
    "proposalVersion",
    "evidenceHash",
    "previousStatus",
    "newStatus",
    "payloadHash",
    "timestamp"
  ],
  "properties": {
    "missionId": { "type": "string", "minLength": 1 },
    "companyId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["APPROVE", "REJECT"] },
    "proposalVersion": {
      "type": "integer",
      "minimum": 0,
      "description": "JSON integer — never a float"
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "lowercase hex sha-256 over the id-sorted evidence set"
    },
    "previousStatus": { "type": "string", "minLength": 1 },
    "newStatus": { "type": "string", "minLength": 1 },
    "payloadHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "lowercase hex sha-256 over the canonical payload (carries the binding digest, design §3.3)"
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
