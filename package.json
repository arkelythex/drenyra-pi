{
  "name": "drenyra-pi",
  "version": "0.0.1-prealpha.1",
  "description": "Pi-native Accounting Operations Harness — consumes a pinned, verified, package-local Drenyra AI runtime. Zero runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "assets",
    "contracts",
    "prompts",
    "skills",
    "agents",
    "chains",
    "vendored",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions/register.js"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./extensions": "./dist/extensions/register.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "postinstall": "node -e \"const{existsSync}=require('node:fs');const{spawnSync}=require('node:child_process');existsSync('dist/scripts/install-drenyra-ai.js')?process.exit(spawnSync(process.execPath,['dist/scripts/install-drenyra-ai.js'],{stdio:'inherit'}).status??1):undefined\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/build.mjs && bun run test && node scripts/verify-package-files.mjs",
    "verify:capability": "node scripts/verify-capability-manifest.mjs",
    "verify:style": "node scripts/verify-style.mjs",
    "prepack": "bun run verify:package",
    "prepublishOnly": "bun run typecheck && bun run verify:package && node scripts/verify-packed-install.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drenyra-ai": "file:./vendored/drenyra-ai-0.4.1.tgz",
    "typebox": "^1.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
