{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drenyra.dev/harness/contracts/evidence/graph.schema.json",
  "title": "EvidenceGraphDocument",
  "description": "A complete evidence graph document for one mission: immutable nodes and directed lineage edges bound to the same mission id (design §7.1/§7.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "missionId", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "missionId": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "node.schema.json" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "edge.schema.json" }
    }
  }
}
