{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drenyra.dev/harness/contracts/authority/authorization-record.schema.json",
  "title": "AuthorizationRecord",
  "description": "An append-only authorization record: the 10-element canonical scope binding, the bound authority mode, and the authorization decision (REQ-CONTRACTS-003; design §3.3/§5.4). scopeHash is lowercase hex sha-256; timestamps are ISO-8601 instants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "mode", "authorization"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "$ref": "scope-binding.schema.json" },
    "mode": { "$ref": "authority-mode.schema.json" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "missionId",
        "scopeHash",
        "authorityMode",
        "actionFamily",
        "actorId",
        "decision",
        "issuedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "scopeHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "lowercase hex sha-256 over the canonical scope (REQ-SCOPE-008)"
        },
        "authorityMode": { "$ref": "authority-mode.schema.json" },
        "actionFamily": {
          "type": "string",
          "enum": ["QUERY", "INVESTIGATE", "PREPARE_CANDIDATE", "APPROVE", "EXECUTE_TARGET"]
        },
        "actorId": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["GRANTED", "DENIED"] },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
